<Window x:Class="PelicanBike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pelican Riding a Bike" Height="640" Width="1000"
        Background="#0E0F12">
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="scene" Width="1000" Height="600" ClipToBounds="True">

            <!-- ============ SKY ============ -->
            <Canvas.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#9FD9FF"/>
                    <GradientStop Offset="0.7" Color="#DFF3FF"/>
                    <GradientStop Offset="1" Color="#F2FAFF"/>
                </LinearGradientBrush>
            </Canvas.Background>

            <!-- Sun -->
            <Ellipse Canvas.Left="850" Canvas.Top="55" Width="86" Height="86" Fill="#FFD75B" Opacity="0.95"/>
            <Ellipse Canvas.Left="838" Canvas.Top="43" Width="110" Height="110" Fill="#FFE9A0" Opacity="0.35"/>

            <!-- Clouds (drift) -->
            <Canvas x:Name="cloud1" Canvas.Left="120" Canvas.Top="60" Opacity="0.92">
                <Ellipse Canvas.Left="0"  Canvas.Top="14" Width="70" Height="30" Fill="White"/>
                <Ellipse Canvas.Left="34" Canvas.Top="0"  Width="62" Height="44" Fill="White"/>
                <Ellipse Canvas.Left="76" Canvas.Top="16" Width="64" Height="28" Fill="White"/>
            </Canvas>
            <Canvas x:Name="cloud2" Canvas.Left="480" Canvas.Top="30" Opacity="0.85">
                <Ellipse Canvas.Left="0"  Canvas.Top="10" Width="56" Height="24" Fill="White"/>
                <Ellipse Canvas.Left="26" Canvas.Top="0"  Width="50" Height="34" Fill="White"/>
                <Ellipse Canvas.Left="60" Canvas.Top="12" Width="52" Height="22" Fill="White"/>
            </Canvas>
            <Canvas x:Name="cloud3" Canvas.Left="780" Canvas.Top="140" Opacity="0.8">
                <Ellipse Canvas.Left="0"  Canvas.Top="8" Width="48" Height="20" Fill="White"/>
                <Ellipse Canvas.Left="22" Canvas.Top="0" Width="44" Height="28" Fill="White"/>
                <Ellipse Canvas.Left="52" Canvas.Top="10" Width="44" Height="18" Fill="White"/>
            </Canvas>

            <!-- Hills (parallax, two copies each) -->
            <Path x:Name="hillsBackA"  Fill="#A9D8A2" Data="M 0 500 L 0 435 Q 125 372 250 435 T 500 435 T 750 435 T 1000 435 L 1000 500 Z"/>
            <Path x:Name="hillsBackB"  Fill="#A9D8A2" Data="M 0 500 L 0 435 Q 125 372 250 435 T 500 435 T 750 435 T 1000 435 L 1000 500 Z"/>
            <Path x:Name="hillsFrontA" Fill="#8CC27E" Data="M 0 500 L 0 468 Q 160 420 320 468 T 640 468 T 960 468 L 1000 462 L 1000 500 Z"/>
            <Path x:Name="hillsFrontB" Fill="#8CC27E" Data="M 0 500 L 0 468 Q 160 420 320 468 T 640 468 T 960 468 L 1000 462 L 1000 500 Z"/>

            <!-- Road + grass -->
            <Rectangle Canvas.Left="0" Canvas.Top="500" Width="1000" Height="46" Fill="#55565C"/>
            <Rectangle Canvas.Left="0" Canvas.Top="500" Width="1000" Height="3"  Fill="#3E3F44"/>
            <Rectangle Canvas.Left="0" Canvas.Top="546" Width="1000" Height="54" Fill="#7FBF5F"/>
            <Canvas x:Name="roadDashes" Canvas.Left="0" Canvas.Top="520"/>

            <!-- ============ BIKE + PELICAN ============ -->
            <!-- rear wheel -->
            <Canvas x:Name="rearWheel" Canvas.Left="305" Canvas.Top="390">
                <Ellipse Width="110" Height="110" Stroke="#2A2A2A" StrokeThickness="7"/>
                <Canvas x:Name="rearSpokes">
                    <Line X1="5" Y1="55" X2="105" Y2="55"  Stroke="#9AA0A6" StrokeThickness="2"/>
                    <Line X1="55" Y1="5"  X2="55" Y2="105" Stroke="#9AA0A6" StrokeThickness="2"/>
                    <Line X1="19" Y1="19" X2="91" Y2="91"  Stroke="#9AA0A6" StrokeThickness="2"/>
                    <Line X1="91" Y1="19" X2="19" Y2="91"  Stroke="#9AA0A6" StrokeThickness="2"/>
                </Canvas>
                <Ellipse Canvas.Left="48" Canvas.Top="48" Width="14" Height="14" Fill="#44464B"/>
            </Canvas>

            <!-- front wheel -->
            <Canvas x:Name="frontWheel" Canvas.Left="505" Canvas.Top="390">
                <Ellipse Width="110" Height="110" Stroke="#2A2A2A" StrokeThickness="7"/>
                <Canvas x:Name="frontSpokes">
                    <Line X1="5" Y1="55" X2="105" Y2="55"  Stroke="#9AA0A6" StrokeThickness="2"/>
                    <Line X1="55" Y1="5"  X2="55" Y2="105" Stroke="#9AA0A6" StrokeThickness="2"/>
                    <Line X1="19" Y1="19" X2="91" Y2="91"  Stroke="#9AA0A6" StrokeThickness="2"/>
                    <Line X1="91" Y1="19" X2="19" Y2="91"  Stroke="#9AA0A6" StrokeThickness="2"/>
                </Canvas>
                <Ellipse Canvas.Left="48" Canvas.Top="48" Width="14" Height="14" Fill="#44464B"/>
            </Canvas>

            <!-- chain + chainring -->
            <Line X1="360" Y1="438" X2="460" Y2="430" Stroke="#5A5C62" StrokeThickness="2.5"/>
            <Line X1="360" Y1="452" X2="460" Y2="460" Stroke="#5A5C62" StrokeThickness="2.5"/>
            <Ellipse Canvas.Left="444" Canvas.Top="429" Width="32" Height="32" Stroke="#5A5C62" StrokeThickness="2.5"/>

            <!-- frame -->
            <Line X1="360" Y1="445" X2="460" Y2="445" Stroke="#D23B3B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="360" Y1="445" X2="432" Y2="344" Stroke="#D23B3B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="432" Y1="344" X2="460" Y2="445" Stroke="#D23B3B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="460" Y1="445" X2="554" Y2="350" Stroke="#D23B3B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="434" Y1="346" X2="552" Y2="346" Stroke="#D23B3B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="548" Y1="330" X2="560" Y2="370" Stroke="#B23030" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line X1="556" Y1="352" X2="560" Y2="445" Stroke="#B23030" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <!-- handlebar + seat -->
            <Line X1="551" Y1="333" X2="536" Y2="318" Stroke="#33343A" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Stroke="#33343A" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 536 318 Q 522 310 514 322"/>
            <Rectangle Canvas.Left="406" Canvas.Top="328" Width="48" Height="9" RadiusX="4.5" RadiusY="4.5" Fill="#33343A"/>

            <!-- crank + pedals (animated) -->
            <Line x:Name="crankArm" Stroke="#33343A" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Rectangle x:Name="pedalFar"  Width="18" Height="6" RadiusX="2" Fill="#2A2A2A"/>
            <Rectangle x:Name="pedalNear" Width="18" Height="6" RadiusX="2" Fill="#2A2A2A"/>
            <Ellipse Canvas.Left="454" Canvas.Top="439" Width="12" Height="12" Fill="#33343A"/>

            <!-- far leg -->
            <Line x:Name="thighFar" Stroke="#C96A18" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line x:Name="shinFar"  Stroke="#C96A18" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line x:Name="footFar"  Stroke="#C96A18" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- ============ PELICAN ============ -->
            <Canvas x:Name="pelican">
                <!-- tail -->
                <Path x:Name="tail" Fill="#EDEDED" Stroke="#CFCFCF" StrokeThickness="1.5"
                      Data="M 352 262 L 300 238 L 320 266 L 296 274 L 352 288 Z"/>
                <!-- body -->
                <Ellipse Canvas.Left="338" Canvas.Top="237" Width="124" Height="96" Fill="#FAFAFA" Stroke="#D6D6D6" StrokeThickness="2"/>
                <!-- wing (flaps) reaching to the handlebar -->
                <Path x:Name="wing" Fill="#EFEFEF" Stroke="#C7C7C7" StrokeThickness="2"
                      Data="M 384 248 Q 448 252 506 306 L 517 322 Q 500 332 478 328 Q 420 316 388 292 Q 372 268 384 248 Z"/>
                <!-- neck -->
                <Path Stroke="#FAFAFA" StrokeThickness="26" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 432 252 Q 452 228 462 210"/>
                <!-- crest feathers -->
                <Path Stroke="#EDEDED" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 458 182 Q 448 160 462 156 M 467 178 Q 463 156 478 154"/>
                <!-- head -->
                <Ellipse Canvas.Left="446" Canvas.Top="177" Width="52" Height="52" Fill="#FAFAFA" Stroke="#D6D6D6" StrokeThickness="2"/>
                <!-- upper beak -->
                <Path Fill="#F5A63C" Stroke="#D98F2C" StrokeThickness="1.5"
                      Data="M 490 192 L 592 208 L 586 217 L 489 213 Z"/>
                <!-- lower beak + pouch (bobs) -->
                <Path x:Name="beakLower" Fill="#F7C96B" Stroke="#D98F2C" StrokeThickness="1.5"
                      Data="M 489 215 Q 522 258 568 240 L 586 217 L 490 215 Z"/>
                <!-- eye -->
                <Ellipse Canvas.Left="473" Canvas.Top="189" Width="14" Height="14" Fill="White" Stroke="#C9C9C9" StrokeThickness="1"/>
                <Ellipse Canvas.Left="479" Canvas.Top="193" Width="6.5" Height="6.5" Fill="#1E1E1E"/>
            </Canvas>

            <!-- near leg -->
            <Line x:Name="thighNear" Stroke="#E07A21" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line x:Name="shinNear"  Stroke="#E07A21" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line x:Name="footNear"  Stroke="#E07A21" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        </Canvas>
    </Viewbox>
</Window>